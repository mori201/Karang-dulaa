# --- Supabase (Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT (création des comptes enseignants par l'admin).
# Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (liens des e-mails, QR codes des certificats)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- DULAA AI (facultatif) ---
# Sans clé, l'assistant affiche qu'il n'est pas configuré.
ANTHROPIC_API_KEY=
DULAA_AI_MODEL=claude-opus-5-5
